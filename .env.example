# Copie para .env e preencha. Nunca commite o .env.

# Banco local do docker-compose (npm run db:up)
DATABASE_URL="postgresql://portfolio:portfolio@localhost:5432/portfolio"

# Banco de produção, só lido por `npm run sync:prod` (Vercel > Settings > Environment Variables)
PROD_DATABASE_URL=""

NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# Cloudinary (a mesma conta da produção)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Pasta do Cloudinary deste ambiente (produção usa "portfolio", o padrão)
CLOUDINARY_FOLDER="portfolio-dev"
